{
  "name": "homelove-platform",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "dev:api": "turbo dev --filter=@homelove/api",
    "dev:web": "turbo dev --filter=@homelove/web",
    "build:api": "turbo build --filter=@homelove/api",
    "build:web": "turbo build --filter=@homelove/web"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "eslint": "^9.24.0",
    "prettier": "^3.5.0"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}